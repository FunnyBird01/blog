      function initGlobalPlayer() {
        if (window.globalPlayer) return;
        if (typeof APlayer === 'undefined') {
          setTimeout(initGlobalPlayer, 100);
          return;
        }

        const localAudio = !{JSON.stringify(localAudio)};
