          container: document.getElementById('global-aplayer'),
          fixed: false,
          autoplay: false,
          mutex: true,
          theme: '#49b1f5',
          loop: 'all',
          order: 'list',
          preload: 'auto',
          volume: 0.7,
          audio: localAudio
